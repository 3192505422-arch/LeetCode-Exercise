from typing import List

class Solution:
    def minMoves(self, nums: List[int], limit: int) -> int:
        n = len(nums)
        diff = [0] * (2 * limit + 2)
        
        for i in range(n // 2):
            a = nums[i]
            b = nums[n - 1 - i]
            
            diff[2] += 2
            diff[2 * limit + 1] -= 2

            diff[min(a, b) + 1] -= 1
            diff[max(a, b) + limit + 1] += 1
 
            diff[a + b] -= 1
            diff[a + b + 1] += 1
   
        curr = 0
        ans = float('inf')
        for i in range(2, 2 * limit + 1):
            curr += diff[i]
            ans = min(ans, curr)
        
        return ans
