from typing import List

class Solution:
    def maximumJumps(self, nums: List[int], target: int) -> int:
        n = len(nums)
        dp = [-1] * n
        dp[n - 1] = 0  # 终点不需要再跳
        
        for i in range(n - 2, -1, -1):
            max_steps = -1
            for j in range(i + 1, n):
                if abs(nums[j] - nums[i]) <= target:
                    if dp[j] != -1:
                        max_steps = max(max_steps, dp[j] + 1)
            dp[i] = max_steps
        
        return dp[0]
