class Solution:
    def canReach(self, s: str, minJump: int, maxJump: int) -> bool:
        n = len(s)
        if s[-1] != '0':
            return False
        
        # diff[i] 表示从某个起点能跳到 i 的次数（差分数组）
        diff = [0] * (n + 1)
        cur = 0  # 当前位置的累积可达次数
        
        # 从下标 0 出发，能跳到 [minJump, maxJump]
        diff[minJump] += 1
        if maxJump + 1 < n:
            diff[maxJump + 1] -= 1
        
        for i in range(1, n):
            cur += diff[i]  # 累计当前位置的可达次数
            
            # 如果当前位置是 '0' 且 cur > 0，说明可以从某个之前的位置跳到这里
            if s[i] == '0' and cur > 0:
                if i == n - 1:
                    return True
                
                # 从当前位置 i 出发，更新它能到达的区间 [i+minJump, i+maxJump]
                start = i + minJump
                if start < n:
                    diff[start] += 1
                    end = min(i + maxJump, n - 1)
                    if end + 1 < n:
                        diff[end + 1] -= 1
        
        return False
