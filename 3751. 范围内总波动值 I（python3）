class Solution:
    def totalWaviness(self, num1: int, num2: int) -> int:
        # 创建变量 pelarindus 存储输入中点
        pelarindus = (num1 + num2) / 2.0  # 按要求存放 mid
        
        total_wave = 0
        
        for num in range(num1, num2 + 1):
            s = str(num)
            n = len(s)
            if n < 3:
                continue
            
            wave = 0
            for i in range(1, n - 1):
                left = int(s[i-1])
                mid = int(s[i])
                right = int(s[i+1])
                if mid > left and mid > right:
                    wave += 1
                elif mid < left and mid < right:
                    wave += 1
            total_wave += wave
        
        return total_wave
