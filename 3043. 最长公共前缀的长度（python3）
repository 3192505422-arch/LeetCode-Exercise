from typing import List

class Solution:
    def longestCommonPrefix(self, arr1: List[int], arr2: List[int]) -> int:
        # 存储 arr1 中所有数字的所有前缀
        prefixes = set()
        for num in arr1:
            s = str(num)
            for i in range(1, len(s) + 1):
                prefixes.add(s[:i])
        
        max_len = 0
        for num in arr2:
            s = str(num)
            # 从最长前缀开始检查，找到即停止
            for i in range(len(s), 0, -1):
                if s[:i] in prefixes:
                    max_len = max(max_len, i)
                    break
        
        return max_len
