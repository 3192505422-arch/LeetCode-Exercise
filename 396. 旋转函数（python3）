from typing import List

class Solution:
    def maxRotateFunction(self, nums: List[int]) -> int:
        n = len(nums)
        S = sum(nums)
        
        # 计算 F(0)
        F = 0
        for i in range(n):
            F += i * nums[i]
        
        maxF = F
        # 递推计算 F(1)..F(n-1)
        for i in range(1, n):
            F = F + S - n * nums[n - i]

            if F > maxF:
                maxF = F
        
        return maxF
