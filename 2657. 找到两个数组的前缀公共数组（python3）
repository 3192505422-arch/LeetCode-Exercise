from typing import List

class Solution:
    def findThePrefixCommonArray(self, A: List[int], B: List[int]) -> List[int]:
        n = len(A)
        seenA = [False] * (n + 1)
        seenB = [False] * (n + 1)
        common = 0 
        res = []
        
        for i in range(n):
            # 处理 A[i]
            if not seenA[A[i]]:
                seenA[A[i]] = True
                if seenB[A[i]]:
                    common += 1
            
            # 处理 B[i]
            if not seenB[B[i]]:
                seenB[B[i]] = True
                if seenA[B[i]]:
                    common += 1
            
            res.append(common)
        
        return res
