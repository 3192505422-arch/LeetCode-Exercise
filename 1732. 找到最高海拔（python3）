from typing import List

class Solution:
    def largestAltitude(self, gain: List[int]) -> int:
        current = 0          # 当前海拔，初始为0
        max_altitude = 0     # 最高海拔，初始为0（起点海拔）
        
        for g in gain:
            current += g                # 更新当前海拔
            max_altitude = max(max_altitude, current)  # 更新最大值
        
        return max_altitude
