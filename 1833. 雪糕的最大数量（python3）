from typing import List

class Solution:
    def maxIceCream(self, costs: List[int], coins: int) -> int:
        # 找到最大价格，用于确定计数数组大小
        max_price = max(costs)
        count = [0] * (max_price + 1)
        
        # 计数排序：统计每个价格出现的次数
        for price in costs:
            count[price] += 1
        
        # 贪心购买：从最便宜的雪糕开始买
        total = 0
        for price in range(1, max_price + 1):
            if count[price] == 0:
                continue
            
            # 当前价格能买的最多数量
            can_buy = min(count[price], coins // price)
            total += can_buy
            coins -= can_buy * price
            
            # 如果剩余钱不够买当前价格的雪糕，后面的更贵，直接退出
            if coins < price:
                break
        
        return total
