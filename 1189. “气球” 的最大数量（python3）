class Solution:
    def maxNumberOfBalloons(self, text: str) -> int:
        from collections import Counter
        
        # 统计 text 中每个字母出现的次数
        count = Counter(text)
        
        # 计算能拼出多少个 "balloon"
        # 注意：'l' 和 'o' 在 "balloon" 中各出现 2 次
        b = count.get('b', 0)
        a = count.get('a', 0)
        l = count.get('l', 0) // 2
        o = count.get('o', 0) // 2
        n = count.get('n', 0)
        
        # 返回最小值，因为每个 "balloon" 都需要这些字母
        return min(b, a, l, o, n)
