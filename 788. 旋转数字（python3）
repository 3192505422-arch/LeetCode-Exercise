class Solution:
    def rotatedDigits(self, n: int) -> int:
        def is_good(x: int) -> bool:
            s = str(x)
            rotated = []
            for ch in s:
                if ch in '018':
                    rotated.append(ch)
                elif ch == '2':
                    rotated.append('5')
                elif ch == '5':
                    rotated.append('2')
                elif ch == '6':
                    rotated.append('9')
                elif ch == '9':
                    rotated.append('6')
                else:
                    return False  # 包含 3,4,7
            # 检查旋转后是否不同
            return int(''.join(rotated)) != x

        count = 0
        for i in range(1, n + 1):
            if is_good(i):
                count += 1
        return count
